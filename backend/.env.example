# PostgreSQL connection
DATABASE_URL=postgresql://dbname@localhost:5432/eravenda

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (checkout payments) — get these from your Paystack dashboard.
# Use the TEST secret key (starts with sk_test_) until you're ready to go live.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (password reset, contact form notifications). Leave SMTP_HOST blank
# to just log emails to the console during local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@eravenda.com
# Inbox that receives Contact Us notifications. Set this in Render too.
SUPPORT_EMAIL=
# Inbox that receives order and delivery confirmations.
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FLYER_URL=

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=

# Database pool tuning (optional; defaults are suitable for local development).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# Product commission policy. The discount ends on the earlier of the date
# window or vendor cap. Handyman commission remains separate.
COMMISSION_LAUNCH_START_DATE=2026-10-14
COMMISSION_LAUNCH_DURATION_DAYS=90
COMMISSION_LAUNCH_VENDOR_CAP=20

# Handyman fee is separate from product commission and is charged to the pro.
SERVICE_COMMISSION_RATE=0.10

# Your real domain once deployed, used to build sitemap.xml URLs
SITE_URL=https://www.eravenda.com
