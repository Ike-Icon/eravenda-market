# PostgreSQL connection
DATABASE_URL=postgresql://dbname@localhost:5432/eravenda

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=

# Your real domain once deployed, used to build sitemap.xml URLs
SITE_URL=https://www.eravenda.com
